{
    "name": "datatables.net-searchbuilder-se",
    "description": "SearchBuilder for DataTables with styling for [SemanticUI](https://semantic-ui.com/)",
    "main": "./js/searchBuilder.semanticui.js",
    "module": "./js/searchBuilder.semanticui.mjs",
    "style": "./css/searchBuilder.semanticui.css",
    "types": "./types/searchBuilder.semanticui.d.ts",
    "version": "2.1.0",
    "files": [
        "js",
        "css",
        "types"
    ],
    "keywords": [
        "SearchBuilder",
        "Filtering",
        "Search",
        "Semantic",
        "SemanticUI",
        "Semantic UI",
        "Datatables",
        "table",
        "filter",
        "sort"
    ],
    "dependencies": {
        "datatables.net-searchbuilder": "2.1.0",
        "datatables.net-se": "^3.1"
    },
    "author": {
        "name": "SpryMedia Ltd",
        "url": "http://datatables.net"
    },
    "homepage": "https://datatables.net",
    "bugs": "https://datatables.net/forums",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DataTables/SearchBuilder.git"
    },
    "exports": {
        ".": {
            "types": "./types/searchBuilder.semanticui.d.ts",
            "style": "./css/searchBuilder.semanticui.css",
            "import": "./js/searchBuilder.semanticui.mjs",
            "require": "./js/searchBuilder.semanticui.js",
            "default": "./js/searchBuilder.semanticui.mjs"
        },
        "./js/*": "./js/*",
        "./css": {
            "types": "./types/css.d.ts",
            "default": "./css/searchBuilder.semanticui.css"
        },
        "./css/*": {
            "types": "./types/css.d.ts",
            "default": "./css/*"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": true
}